# CuraTwin Environment Variables
# Copy this file to .env and fill in your own values.

# Required in production — generate with: openssl rand -hex 32
SECRET_KEY=

# Database (Neon/Postgres). Local dev uses SQLite automatically if unset.
DATABASE_URL=postgresql://user:password@host/dbname

# Optional: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000

# Optional: set to 1 to auto-create tables on startup (dev only)
AUTO_CREATE_TABLES=0
